{
  "name": "coach-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Custom WordPress coaching theme with ACF and Tailwind CSS",
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/input.css -o ./assets/css/theme.css --minify",
    "watch:css": "tailwindcss -i ./src/css/input.css -o ./assets/css/theme.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.13",
    "tailwindcss": "^3.4.17"
  }
}
